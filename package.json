{
  "name": "@yafnet/sceditor",
  "version": "3.2.16",
  "description": "Forked SCEditor for YAF.NET.",
  "homepage": "http://www.sceditor.com/",
  "bugs": "https://github.com/samclarke/SCEditor/issues",
  "license": "MIT",
  "author": "Sam Clarke <sam@samclarke.com>",
  "contributors": [
    {
      "name": "w8tcha"
    }
  ],
  "files": [
    "dist/",
    "src/",
    "CHANGELOG.txt",
    "LICENSE.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/yafnet/SCEditor.git"
  },
  "keywords": [
    "WYSIWYG",
    "BBCode",
    "editor",
    "contenteditable",
    "ui"
  ],
  "engines": {
    "node": ">= 0.10.0"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "scripts": {
    "test": "eslint . && tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:manual-tests": "node scripts/build-manual-tests.mjs",
    "lint": "eslint .",
    "update-deps": "npm install"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.2",
    "jsdom": "^29.1.1",
    "loader-utils": "^3.3.1",
    "playwright": "^1.61.1",
    "postcss": "^8.5.20",
    "postcss-header": "^3.0.3",
    "rangy": "^1.3.2",
    "sass": "^1.101.3",
    "sinon": "^22.1.0",
    "terser": "^5.49.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "webpack": "^5.108.4",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.12"
  }
}
