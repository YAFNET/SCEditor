{
  "name": "@yafnet/sceditor",
  "version": "3.2.18",
  "description": "Forked SCEditor for YAF.NET.",
  "homepage": "http://www.sceditor.com/",
  "bugs": "https://github.com/samclarke/SCEditor/issues",
  "license": "MIT",
  "author": "Sam Clarke <sam@samclarke.com>",
  "contributors": [
    {
      "name": "w8tcha"
    }
  ],
  "files": [
    "dist/",
    "src/",
    "CHANGELOG.txt",
    "LICENSE.md",
    "README.md"
  ],
  "type": "module",
  "main": "dist/sceditor.umd.min.js",
  "module": "dist/sceditor.esm.min.js",
  "unpkg": "dist/sceditor.min.js",
  "jsdelivr": "dist/sceditor.min.js",
  "exports": {
    ".": {
      "import": "./dist/sceditor.esm.min.js",
      "require": "./dist/sceditor.umd.min.js",
      "default": "./dist/sceditor.min.js"
    },
    "./dist/*": "./dist/*",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/YAFNET/SCEditor"
  },
  "keywords": [
    "WYSIWYG",
    "BBCode",
    "editor",
    "contenteditable",
    "ui"
  ],
  "engines": {
    "node": ">= 0.10.0"
  },
  "browserslist": [
    "last 2 versions"
  ],
  "scripts": {
    "test": "eslint . && tsc --noEmit && vitest run",
    "test:watch": "vitest",
    "dev": "vite",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "build:manual-tests": "node scripts/build-manual-tests.mjs",
    "lint": "eslint .",
    "update-deps": "set npm_config_allow_scripts=&& npm-check -y"
  },
  "devDependencies": {
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "autoprefixer": "^10.5.4",
    "cssnano": "^8.0.9",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "loader-utils": "^3.3.1",
    "playwright": "^1.62.1",
    "postcss": "^8.5.26",
    "postcss-header": "^3.0.3",
    "rangy": "^1.3.2",
    "sass": "^1.103.1",
    "sinon": "^22.1.0",
    "terser": "^5.50.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webpack": "^5.109.2",
    "webpack-dev-server": "^6.0.0"
  },
  "dependencies": {
    "dompurify": "^3.4.14"
  }
}
